# Instagram アプリ ID（Meta アプリ ID ではない）
IG_APP_ID=

# ダッシュボードの「トークンを生成」で発行したものを貼り付ける
IG_ACCESS_TOKEN=

# npm run whoami が表示する user_id（17841… で始まる）
IG_USER_ID=

# --- 以下は OAuth フローを実装する場合のみ使用（現在は未使用） ---
IG_APP_SECRET=
IG_REDIRECT_URI=

# API バージョン（開発者ダッシュボードで現行版を確認して設定）
IG_API_VERSION=v23.0

# 画像の公開 URL のベース（content/assets を指す raw URL）
ASSET_BASE_URL=https://raw.githubusercontent.com/<user>/ig-auto/main/content/assets

# true の間は実際の投稿を行わない
DRY_RUN=true
