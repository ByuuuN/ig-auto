# Meta アプリの設定画面から取得
IG_APP_ID=
IG_APP_SECRET=

# Business Login settings に登録したものと完全一致させる
IG_REDIRECT_URI=https://<your-github-username>.github.io/ig-auto/

# exchange.js の実行後に取得して貼り付ける
IG_ACCESS_TOKEN=
IG_USER_ID=

# API バージョン（開発者ダッシュボードで現行版を確認して設定）
IG_API_VERSION=v23.0

# 画像の公開 URL のベース（content/assets を指す raw URL）
ASSET_BASE_URL=https://raw.githubusercontent.com/<user>/ig-auto/main/content/assets

# true の間は実際の投稿を行わない
DRY_RUN=true
